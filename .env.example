# Copy this file to .env and fill it in. Only needed for scripts/load_snowflake.py

# Account identifier: in Snowsight, click your name (bottom left) > Account > View account details
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_USER

# Pick ONE way to log in. externalbrowser opens a browser tab and works with MFA.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WORKFORCE_DEMO
SNOWFLAKE_SCHEMA=HR
