# Copy this file to .env and fill it in. Never commit .env.

# ---- LLM (Day 3: scripts/ask.py and scripts/smoke_test.py) ----
# Default: open-weight models on Groq's free tier (key from console.groq.com/keys)
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Others on Groq to compare: openai/gpt-oss-20b (check what your key can use)

# Prompt version: v1 (Day 3), v2 (smoke-test fixes), v3 (fixes from the v1 vs v2 eval)
PROMPT_VERSION=v4

# Or Claude, if you have a key:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# ---- Snowflake (optional: scripts/load_snowflake.py) ----

# Account identifier: in Snowsight, click your name (bottom left) > Account > View account details
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_USER

# Pick ONE way to log in. externalbrowser opens a browser tab and works with MFA.
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=WORKFORCE_DEMO
SNOWFLAKE_SCHEMA=HR
